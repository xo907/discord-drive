# systemd *user* unit. Assumes the repository is at ~/DiscordDrive;
# install_debian.sh prints a command that rewrites the path for you.
#   systemctl --user enable --now discorddrive
#   sudo loginctl enable-linger $USER     # keep it running without a login session
[Unit]
Description=DiscordDrive encrypted Discord-backed drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/DiscordDrive
Environment=PYTHONPATH=%h/DiscordDrive
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m discorddrive mount
# Unmounting makes the daemon flush uploads and back up the index before exiting.
ExecStop=/usr/bin/python3 -m discorddrive stop
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
